# ---------------------------------------------------------------------------
# Laravel / PHP
# ---------------------------------------------------------------------------
/vendor/
/bootstrap/cache/*.php
/bootstrap/compiled.php

# Runtime-generated storage (keep the folder structure via each dir's .gitignore)
/storage/*.key
/storage/pail
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/debugbar
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

# ---------------------------------------------------------------------------
# Environment & secrets  — NEVER commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.env.backup
.env.production
auth.json
/storage/oauth-*.key

# ---------------------------------------------------------------------------
# Front-end build tooling
# ---------------------------------------------------------------------------
/node_modules/
npm-debug.log
yarn-error.log
/public/hot
/public/js
/public/css
/public/mix-manifest.json
Homestead.json
Homestead.yaml
/.vagrant

# NOTE: /public/assets is committed on purpose — it is pre-built vendored
# theme content and is NOT produced by any build step in this project.

# ---------------------------------------------------------------------------
# User-generated / server-owned content  (must persist across deploys)
# ---------------------------------------------------------------------------
/public/uploads/*
!/public/uploads/.gitignore
!/public/uploads/.htaccess
/public/storage
/public/logs/*
!/public/logs/.gitignore
/public/app-translations
/public/all
/public/addons/*
!/public/addons/.gitignore

# ---------------------------------------------------------------------------
# Active eCommerce updater / install artifacts
# ---------------------------------------------------------------------------
/updates/
updates.zip
install.zip
ecommerce.zip
/public/install
/resources/lang/*.json
!/resources/lang/en.json

# ---------------------------------------------------------------------------
# IDE / OS / editor junk
# ---------------------------------------------------------------------------
.idea/
.vscode/
.fleet/
.nova/
.zed/
*.sublime-project
*.sublime-workspace
.phpstorm.meta.php
_ide_helper.php
_ide_helper_models.php
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Misc backups / dumps that should never be in the repo
# ---------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.sql
*.sqlite
*.sql.gz
*.log
*.bak
*.orig
*.save
*.swp
/temp/*
!/temp/.gitignore

# ...but keep the upstream Active eCommerce upgrade-SQL history (small, reference only)
!/sqlupdates/
!/sqlupdates/*.sql

# CI / local tooling
/.phpunit.cache
/.phpunit.result.cache
.php-cs-fixer.cache
/coverage
