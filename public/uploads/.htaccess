# Writable directory — serve static files only, never execute code.
# (Guards keep this safe under mod_php, PHP-FPM and LiteSpeed alike.)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule \.(php|php\d|phtml|phar|pht|phps|cgi|pl|py|sh|asp|aspx)$ - [F,L,NC]
</IfModule>

<FilesMatch "\.(php|php\d|phtml|phar|pht|phps|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht
</IfModule>

<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_admin_flag engine off
</IfModule>

Options -Indexes
